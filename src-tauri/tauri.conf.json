{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "简记",
  "version": "0.1.0",
  "identifier": "com.yu06118.jianji",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "简记",
        "width": 400,
        "height": 860,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#202020"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
